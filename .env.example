# Copy to .env (git-ignored) for local runs. In production set these as environment variables.
# Never commit real values.

# OpenRouter key from https://openrouter.ai/keys. Put a credit limit on the key there.
OPENROUTER_API_KEY=sk-or-...

# Supabase project -> Settings -> API. Use the *publishable* key (sb_publishable_..., formerly "anon").
# Row Level Security (database/schema.sql) is what keeps users' data apart. Never put the *secret*
# key here; the app refuses to start with it.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional. The JWKS URL defaults to SUPABASE_URL + /auth/v1/.well-known/jwks.json.
# COMPASS_MODEL=meta-llama/llama-4-maverick
# MAX_USER_MESSAGES_PER_DAY=50
# COMPASS_SITE_URL=https://your-app.example.com   # sent as HTTP-Referer for OpenRouter attribution
