# Copy to .streamlit/secrets.toml (git-ignored) for local runs.
# On Streamlit Community Cloud, paste the same keys into the app's Secrets box.
# Never commit real values.

# OpenRouter key from https://openrouter.ai/keys. Set a credit limit on the key there.
OPENROUTER_API_KEY = "sk-or-..."

# Supabase project -> Settings -> API Keys. Use the *publishable* key (sb_publishable_...,
# formerly the "anon" key). Row Level Security (see database/schema.sql) is what keeps
# users' data apart. Never put the *secret* key here; the app refuses to start with it.
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY = "sb_publishable_..."

# Optional
# COMPASS_MODEL = "meta-llama/llama-4-maverick"
# MAX_USER_MESSAGES_PER_DAY = 50
# COMPASS_SITE_URL = "https://your-app.streamlit.app"  # sent as HTTP-Referer for OpenRouter attribution
