# Copy to .streamlit/secrets.toml (git-ignored) for local runs.
# On Streamlit Community Cloud, paste the same keys into the app's Secrets box.
# Never commit real values.

ANTHROPIC_API_KEY = "sk-ant-..."

# Supabase project -> Settings -> API. Use the *anon* key only. Row Level Security
# (see supabase/schema.sql) is what keeps users' data apart; never use the service key.
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY = "eyJ..."

# Optional
# COMPASS_MODEL = "claude-opus-5-5"
# MAX_USER_MESSAGES_PER_DAY = 50
